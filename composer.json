{
    "name": "becklyn/ddd-core",
    "description": "DDD framework for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Christoph Hautzinger",
            "email": "ch@becklyn.com"
        },
        {
            "name": "Marko Vujnovic",
            "email": "ms@becklyn.com"
        }
    ],
    "require": {
        "becklyn/utilities": "^3.0",
        "illuminate/collections": "^8.12 || ^9.0 || ^10.0 || ^11.0",
        "php": ">=8.2",
        "ramsey/uuid": "^4.0",
        "symfony/service-contracts": "^2.5 || ^3.0",
        "webmozart/assert": "^1.9"
    },
    "require-dev": {
        "phpspec/prophecy-phpunit": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Becklyn\\Ddd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Becklyn\\Ddd\\Tests\\": "tests/"
        }
    }
}
